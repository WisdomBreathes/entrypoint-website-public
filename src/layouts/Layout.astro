---
import { homeHero } from '../data/home-hero';

const base = import.meta.env.BASE_URL;

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /**
   * Pass the key of the above-the-fold hero image for this page.
   * The Layout will emit a correctly-sized <link rel="preload"> for it.
   * Omit on pages with no image hero (e.g. privacy, terms).
   */
  heroImage?: 'home' | 'about' | 'contact' | 'programs' | 'services';
}

const {
  title,
  description = 'Entrypoint Canada Immigration Services is a regulated Canadian immigration consultancy serving Cambridge, Kitchener, Waterloo, and the surrounding area with guidance on permanent residence, family sponsorship, study permits, work permits, citizenship applications, and humanitarian matters.',
  noindex = false,
  schema,
  heroImage,
} = Astro.props;

// Map page → WebP filenames (mobile 800w + desktop 1400w)
const heroImageMap = {
  about:    { m: 'leonard-laub-X8Dc_8rXZHA-unsplash-800w.webp',       d: 'leonard-laub-X8Dc_8rXZHA-unsplash-1400w.webp' },
  contact:  { m: 'john-lee-oMneOBYhJxY-unsplash-800w.webp',           d: 'john-lee-oMneOBYhJxY-unsplash-1400w.webp' },
  programs: { m: 'cole-keister-rydTSO7xB5A-unsplash-800w.webp',       d: 'cole-keister-rydTSO7xB5A-unsplash-1400w.webp' },
  services: { m: 'ashley-ross-qZEeC8t0UKE-unsplash-800w.webp',        d: 'ashley-ross-qZEeC8t0UKE-unsplash-1400w.webp' },
};
const heroPreload = heroImage && heroImage !== 'home' ? heroImageMap[heroImage] : null;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const robotsContent = noindex ? 'noindex, nofollow' : 'index, follow';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Entrypoint Canada" />
    <meta property="og:locale" content="en_CA" />

    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

    <link rel="preload" href={`${base}fonts/inter-latin.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}fonts/playfair-display-latin.woff2`} as="font" type="font/woff2" crossorigin />

    {heroImage === 'home' && [homeHero.mobile, homeHero.wide].map((crop) => (
      <link rel="preload" as="image" media={crop.media} imagesrcset={crop.srcset} imagesizes="100vw" fetchpriority="high" />
    ))}

    <!-- Preload the above-the-fold image on inner pages. -->
    {heroPreload && (
      <>
        <link
          rel="preload"
          as="image"
          href={`${base}images/${heroPreload.m}`}
          imagesrcset={`${base}images/${heroPreload.m} 800w, ${base}images/${heroPreload.d} 1400w`}
          imagesizes="100vw"
          fetchpriority="high"
        />
      </>
    )}

    <!-- View transitions -->
    <style>
      @view-transition { navigation: auto; }
      ::view-transition-old(root) { animation: 0.2s ease both vt-fade-out; }
      ::view-transition-new(root) { animation: 0.2s ease both vt-fade-in; }
      @keyframes vt-fade-out { from { opacity: 1; } to { opacity: 0; } }
      @keyframes vt-fade-in  { from { opacity: 0; } to { opacity: 1; } }
    </style>

    <style>
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 300 600;
        font-display: swap;
        src: url('/fonts/inter-latin.woff2') format('woff2');
      }

      @font-face {
        font-family: 'Playfair Display';
        font-style: normal;
        font-weight: 600 700;
        font-display: swap;
        src: url('/fonts/playfair-display-latin.woff2') format('woff2');
      }
    </style>

    <title>{title}</title>

    <!-- Structured data — LocalBusiness + ProfessionalService -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": ["LocalBusiness", "ProfessionalService"],
      "name": "Entrypoint Canada Immigration Services",
      "description": "Regulated Canadian immigration practice serving Cambridge, Kitchener, Waterloo, and surrounding Ontario communities. Licensed by the College of Immigration and Citizenship Consultants (CICC). Guidance available for Express Entry, family sponsorship, study permits, work permits, citizenship applications, LMIA matters, and refugee protection claims.",
      "url": "https://entrypointcanada.com",
      "logo": "https://entrypointcanada.com/logo-icon.svg",
      "telephone": "+16479060011",
      "email": "info@entrypointcanada.com",
      "availableLanguage": ["English", "Urdu", "Bengali", "Hindi"],
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "37 Faith St",
        "addressLocality": "Cambridge",
        "addressRegion": "ON",
        "addressCountry": "CA"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 43.3616,
        "longitude": -80.3144
      },
      "areaServed": [
        {
          "@type": "City",
          "name": "Cambridge"
        },
        {
          "@type": "City",
          "name": "Kitchener"
        },
        {
          "@type": "City",
          "name": "Waterloo"
        },
        {
          "@type": "AdministrativeArea",
          "name": "Regional Municipality of Waterloo"
        },
        {
          "@type": "State",
          "name": "Ontario"
        },
        {
          "@type": "Country",
          "name": "Canada"
        }
      ],
      "serviceType": [
        "Immigration Consultant Services",
        "Express Entry Immigration",
        "Provincial Nominee Program",
        "Family Sponsorship",
        "Study Permits",
        "Work Permits",
        "Canadian Citizenship Applications",
        "Refugee and Humanitarian Claims",
        "LMIA Applications",
        "Post-Graduation Work Permits"
      ],
      "knowsAbout": [
        "Canadian immigration consultant in Cambridge Ontario",
        "Immigration consultant in Kitchener-Waterloo",
        "Express Entry",
        "Ontario Immigrant Nominee Program",
        "Post-Graduation Work Permit",
        "LMIA work permits",
        "Spousal sponsorship",
        "Family sponsorship",
        "Study permits",
        "Canadian citizenship applications"
      ],
      "priceRange": "$$",
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "09:00",
        "closes": "18:00"
      },
      "sameAs": [
        "https://register.college-ic.ca/"
      ]
    }
    </script>

    <!-- Structured data — Person (Sabiha Iftakhar, RCIC) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Sabiha Iftakhar",
      "jobTitle": "Regulated Canadian Immigration Consultant (RCIC)",
      "description": "Sabiha Iftakhar is a Regulated Canadian Immigration Consultant (RCIC) licensed by the College of Immigration and Citizenship Consultants (CICC), registration number R412247. Based in Cambridge and serving Kitchener-Waterloo with 15+ years of experience across study permits, work permits, permanent residence, family sponsorship, citizenship applications, and other Canadian immigration matters.",
      "url": "https://entrypointcanada.com/about",
      "email": "info@entrypointcanada.com",
      "telephone": "+16479060011",
      "knowsLanguage": ["English", "Urdu", "Bengali", "Hindi"],
      "worksFor": {
        "@type": "LocalBusiness",
        "name": "Entrypoint Canada Immigration Services",
        "url": "https://entrypointcanada.com"
      },
      "hasCredential": {
        "@type": "EducationalOccupationalCredential",
        "credentialCategory": "Professional Licence",
        "name": "Regulated Canadian Immigration Consultant (RCIC)",
        "recognizedBy": {
          "@type": "Organization",
          "name": "College of Immigration and Citizenship Consultants (CICC)",
          "url": "https://college-ic.ca"
        }
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Cambridge",
        "addressRegion": "ON",
        "addressCountry": "CA"
      }
    }
    </script>

    {schema && (
      Array.isArray(schema)
        ? schema.map((schemaItem) => <script type="application/ld+json" set:html={JSON.stringify(schemaItem)} />)
        : <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
  </head>
  <body>
    <!-- Skip to main content (WCAG) -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <slot />
  </body>
</html>

<style is:global>
  /* ── Reset & base ── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html {
    --site-max-width: 1200px;
    --site-gutter: 56px;
    --site-section-space: 64px;
    --site-nav-height: 64px;
    --site-header-height: calc(var(--site-nav-height) + 1px);
    --site-line: #E8E3D9;
    --site-maroon: #3D1215;
    scroll-behavior: smooth;
    background: #FAF7F2;
  }

  @media (max-width: 1023px) {
    html { --site-gutter: 32px; }
  }

  @media (max-width: 768px) {
    html { --site-gutter: 24px; --site-section-space: 56px; }
  }

  body {
    font-family: 'Inter', system-ui, sans-serif;
    color: #1A1A2E;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  a { text-decoration: none; }

  /* ── Skip link ── */
  .skip-link {
    position: absolute;
    top: -48px;
    left: 16px;
    z-index: 1000;
    background: #3D1215;
    color: white;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 6px;
    transition: top 0.15s;
  }
  .skip-link:focus { top: 8px; }

  /* ── Focus visible ── */
  :focus-visible {
    outline: 2px solid #C4973A;
    outline-offset: 2px;
  }

  /* ── Buttons ── */
  .btn-gold {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #C4973A;
    color: #1A0F00;
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 600;
    padding: 14px 28px;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.18s ease;
  }
  .btn-gold:hover { background-color: #D4AF62; }

  .btn-burgundy {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #3D1215;
    color: white;
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 600;
    padding: 14px 24px;
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.15);
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.18s ease;
  }
  .btn-burgundy:hover {
    background: #2C0D0F;
  }

  .btn-crimson {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #8B1A1A;
    color: white;
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 600;
    padding: 14px 24px;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.18s ease;
  }
  .btn-crimson:hover {
    background: #A0272A;
  }

  :where(.btn-gold, .btn-burgundy, .btn-crimson, .program-inline-link, .page-back-link) > svg {
    flex: none;
  }

  /* ── Nav links ── */
  .nav-link {
    position: relative;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: #1A1A2E;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1.5px;
    background: #3D1215;
    transition: width 0.25s ease;
  }
  .nav-link:hover { color: #3D1215; }
  .nav-link:hover::after { width: 100%; }

  /* ── Service cards ── */
  .service-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: #F4F1EB;
    border: 1px solid #E8E3D9;
    border-radius: 10px;
    padding: 24px;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .service-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 40px rgba(61, 18, 21, 0.12);
  }
  .service-card:focus-visible {
    outline: 2px solid #1C2456;
    outline-offset: 2px;
  }

  /* ── About card ── */
  .about-card {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .about-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 48px rgba(61, 18, 21, 0.2);
  }

  /* ── Stat items ── */
  .stat-item {
    transition: transform 0.2s ease;
    cursor: default;
  }
  .stat-item:hover { transform: scale(1.05); }

  /* ── Responsive grids ── */
  .grid-services {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 640px) {
    .grid-services { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1024px) {
    .grid-services { grid-template-columns: 1fr 1fr 1fr; }
  }

  .grid-2col {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  @media (min-width: 1024px) {
    .grid-2col { grid-template-columns: 1fr 1fr; }
  }

  .grid-testimonials {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 768px) {
    .grid-testimonials { grid-template-columns: 1fr 1fr; }
  }

  .grid-steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    list-style: none;
    padding: 0;
    margin: 0;
    position: relative;
    z-index: 10;
  }
  @media (min-width: 640px) {
    .grid-steps { grid-template-columns: 1fr 1fr 1fr 1fr; gap: 16px; }
  }

  .grid-stats {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 12px;
  }

  /* ── Responsive section padding ── */
  .section-container {
    max-width: var(--site-max-width);
    margin-inline: auto;
    padding: var(--site-section-space) var(--site-gutter);
  }

  /* Inner div for page-level hero sections */
  .page-hero-inner {
    max-width: var(--site-max-width);
    margin: 0 auto;
    padding-inline: var(--site-gutter);
  }
  .page-hero-copy {
    width: min(100%, 720px);
  }
  @media (max-width: 768px) {
    .page-hero-copy { width: 100%; }
  }

  /* Navbar inner */
  .nav-inner {
    max-width: var(--site-max-width);
    margin: 0 auto;
    padding-inline: var(--site-gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--site-nav-height);
  }

  /* ── Flex wrap row centered ── */
  .flex-center-wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  /* ── Keyframes ── */
  @keyframes float {
    0%   { transform: translateY(0px); }
    50%  { transform: translateY(-8px); }
    100% { transform: translateY(0px); }
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Respect reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
