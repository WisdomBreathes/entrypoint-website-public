---
import HomeSectionIntro from './HomeSectionIntro.astro';

const steps = [
  {
    number: '1',
    title: 'Initial Consultation',
    description: 'We talk through your current status, goals, and deadlines to identify which options may apply.',
    circleColor: '#8B1A1A',
  },
  {
    number: '2',
    title: 'Document Review',
    description: 'We identify requirements, gaps, and deadlines before filing.',
    circleColor: '#3D1215',
  },
  {
    number: '3',
    title: 'Application Filing',
    description: 'Your application is prepared for submission with representation before IRCC where retained.',
    circleColor: '#8B1A1A',
  },
  {
    number: '4',
    title: 'Ongoing Support',
    description: 'We assist with follow-ups, document requests, and status updates as the file progresses.',
    circleColor: '#3D1215',
  },
] as const;
---

<section style="background: #ffffff;" aria-labelledby="process-heading">
  <div class="section-container">

    <HomeSectionIntro
      id="process-heading"
      label="Our process"
      title="From the first conversation to follow-up"
      description="We assess your options before you commit to a route. If you retain us, we help prepare your application and handle follow-up within the agreed scope."
      centered
    />

    <!-- Steps: horizontal on desktop, vertical on mobile -->
    <div style="position: relative;">
      <!-- Desktop connector line -->
      <div style="display: none; position: absolute; top: 24px; left: 12.5%; right: 12.5%; height: 1px; border-top: 1px dashed #D9D2C5;" aria-hidden="true" class="connector-line"></div>

      <ol class="grid-steps" role="list">
        {steps.map((step) => (
          <li class="process-step-item">

            <!-- Step circle -->
            <div
              class="process-circle"
              style={`width: 48px; height: 48px; border-radius: 50%; background: ${step.circleColor}; display: flex; align-items: center; justify-content: center; flex-shrink: 0; position: relative;`}
            >
              <span class="process-step-number" style="font-family: 'Playfair Display', Georgia, serif; font-size: 18px; font-weight: 600; color: white;" aria-hidden="true">
                {step.number}
              </span>
            </div>

            <div class="process-step-copy">
              <h3 style="font-family: 'Inter', sans-serif; font-size: 15px; font-weight: 600; color: #1A1A2E; margin-bottom: 6px;">{step.title}</h3>
              <p style="font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 300; color: #45465E; line-height: 1.7; max-width: 220px; margin: 0 auto;">
                {step.description}
              </p>
            </div>

          </li>
        ))}
      </ol>
    </div>

  </div>
</section>

<style>
  .process-step-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
  }

  .process-step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1ch;
    line-height: 1;
    font-variant-numeric: lining-nums tabular-nums;
  }

  .process-step-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  @media (min-width: 640px) {
    .connector-line { display: block !important; }
  }

  @media (max-width: 768px) {
    .grid-steps h3 {
      font-size: 16px !important;
    }
    .grid-steps p {
      font-size: 14px !important;
      line-height: 1.75 !important;
      max-width: 240px !important;
    }
  }

  @media (max-width: 639px) {
    .grid-steps { gap: 24px; }
    .process-step-item { flex-direction: row; align-items: flex-start; gap: 16px; text-align: left; }
    .process-step-copy { align-items: flex-start; }
    .process-step-copy p { max-width: none !important; }
  }
</style>
