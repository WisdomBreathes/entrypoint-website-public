---
import HomeSectionIntro from './HomeSectionIntro.astro';

const base = import.meta.env.BASE_URL;
---

<section class="home-about" aria-labelledby="about-heading">
  <div class="section-container">
    <HomeSectionIntro
      id="about-heading"
      title="Meet Sabiha Iftakhar, RCIC"
    />
    <div class="home-about-grid">
      <img
        class="home-consultant-portrait"
        src={`${base}images/sabiha-iftakhar-portrait.jpg`}
        alt="Portrait of Sabiha Iftakhar"
        width="842"
        height="843"
        loading="lazy"
        decoding="async"
      />
      <div class="home-consultant-copy">
        <p>Sabiha Iftakhar is a Regulated Canadian Immigration Consultant based in Cambridge, Ontario. She works with individuals and families on permanent residence, temporary status, family sponsorship, citizenship, and humanitarian matters.</p>
        <p>She reviews the facts of each matter, explains the risks and timelines, and sets out what can be done. Clients who retain Entrypoint Canada work directly with Sabiha throughout their case.</p>
        <ul class="home-consultant-facts" role="list">
          <li>Member in good standing with the CICC</li>
          <li>Consultations in English, Urdu, Bengali, and Hindi</li>
        </ul>
        <a href={`${base}about/`}>Read about Sabiha and her credentials</a>
      </div>
    </div>
  </div>
</section>

<style>
  .home-about { background: #F4F1EB; }

  .home-about-grid {
    display: grid;
    grid-template-columns: minmax(0, 256px) minmax(0, 560px);
    align-items: center;
    gap: 32px;
  }

  .home-consultant-portrait {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .home-consultant-copy {
    display: grid;
    gap: 16px;
    color: #45465E;
    font-size: 15px;
    line-height: 1.7;
  }

  .home-consultant-copy a {
    justify-self: start;
    color: #8B1A1A;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .home-consultant-facts {
    display: grid;
    gap: 4px;
    padding-top: 12px;
    border-top: 1px solid #D9D2C5;
    list-style: none;
    font-size: 13px;
  }

  @media (max-width: 639px) {
    .home-about-grid { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .home-consultant-portrait { max-width: 224px; }
  }
</style>
