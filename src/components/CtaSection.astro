---
import HomeSectionIntro from './HomeSectionIntro.astro';

const base = import.meta.env.BASE_URL;
---

<section class="home-cta" aria-labelledby="cta-heading">
  <div class="section-container">
    <HomeSectionIntro
      id="cta-heading"
      title="Start with a conversation"
      description="Tell us what you are trying to resolve. We can review which options may fit and what you would need before deciding whether to proceed."
      centered
      inverse
    />
    <div class="home-cta-actions">
      <a href={`${base}contact/`} class="btn-gold">Book a consultation</a>
      <a href="tel:+16479060011" class="home-cta-phone">Call 647-906-0011</a>
    </div>
  </div>
</section>

<style>
  .home-cta { background: #3D1215; }

  .home-cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px 24px;
  }

  .home-cta-phone {
    padding: 8px 0;
    color: #F0D9A8;
    font-size: 15px;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
