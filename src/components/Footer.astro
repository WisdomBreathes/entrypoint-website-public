---
import { homeHero } from '../data/home-hero';

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();

const { homePhotoCredit = false } = Astro.props;
---

<footer role="contentinfo" style="background: #111827;">

  <!-- Legal block -->
  <div class="footer-frame footer-legal">
    <p style="font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 400; color: rgba(255,255,255,0.6); line-height: 1.7; margin-bottom: 6px;">
      Regulated Canadian Immigration Consultant (RCIC) &nbsp;·&nbsp; Licensed by the College of Immigration and Citizenship Consultants (CICC) &nbsp;·&nbsp; RCIC #: R412247
    </p>
    <p style="font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 300; color: rgba(255,255,255,0.6); line-height: 1.7; max-width: 760px;">
      Immigration programs, eligibility requirements, processing times, and intake windows may change without notice based on IRCC, provincial, or pilot program updates. Information on this website is for general guidance only and does not constitute legal advice.
    </p>
    {homePhotoCredit && (
      <p class="footer-photo-credit">Flag photograph by <a href={homeHero.credit.source}>{homeHero.credit.author}</a>.</p>
    )}
  </div>

  <div class="footer-frame footer-bottom">

    <p style="font-family: 'Inter', sans-serif; font-size: 12px; color: rgba(255,255,255,0.68);">
      © {year} Entrypoint Canada Immigration Services. All rights reserved.
      <a
        href="mailto:info@entrypointcanada.com"
        class="footer-email-link"
        style="color: rgba(255,255,255,0.5); text-decoration: underline; margin-left: 4px; transition: color 0.15s;"
      >
        info@entrypointcanada.com
      </a>
    </p>

    <nav aria-label="Footer navigation">
      <ul style="display: flex; flex-wrap: wrap; align-items: center; gap: 16px; list-style: none; padding: 0; margin: 0;" role="list">
        <li>
          <a
            href={`${base}programs/`}
            class="footer-nav-link"
            style="font-family: 'Inter', sans-serif; font-size: 12px; color: rgba(255,255,255,0.65); text-decoration: none; transition: color 0.15s;"
          >
            Programs
          </a>
        </li>
        <li>
          <a
            href={`${base}services/`}
            class="footer-nav-link"
            style="font-family: 'Inter', sans-serif; font-size: 12px; color: rgba(255,255,255,0.65); text-decoration: none; transition: color 0.15s;"
          >
            Services
          </a>
        </li>
        <li>
          <a
            href={`${base}about/`}
            class="footer-nav-link"
            style="font-family: 'Inter', sans-serif; font-size: 12px; color: rgba(255,255,255,0.65); text-decoration: none; transition: color 0.15s;"
          >
            About
          </a>
        </li>
        <li>
          <a
            href={`${base}contact/`}
            class="footer-nav-link"
            style="font-family: 'Inter', sans-serif; font-size: 12px; color: rgba(255,255,255,0.65); text-decoration: none; transition: color 0.15s;"
          >
            Contact
          </a>
        </li>
        <li>
          <a
            href={`${base}privacy/`}
            class="footer-nav-link"
            style="font-family: 'Inter', sans-serif; font-size: 12px; color: rgba(255,255,255,0.65); text-decoration: none; transition: color 0.15s;"
          >
            Privacy Policy
          </a>
        </li>
        <li>
          <a
            href={`${base}terms/`}
            class="footer-nav-link"
            style="font-family: 'Inter', sans-serif; font-size: 12px; color: rgba(255,255,255,0.65); text-decoration: none; transition: color 0.15s;"
          >
            Terms of Use
          </a>
        </li>
      </ul>
    </nav>

  </div>
</footer>

<style>
  .footer-frame {
    max-width: var(--site-max-width);
    margin-inline: auto;
    padding-inline: var(--site-gutter);
  }

  .footer-legal { padding-top: 28px; }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 24px;
    padding-block: 16px 28px;
  }

  .footer-photo-credit {
    margin-top: 8px;
    color: rgba(255,255,255,0.68);
    font-size: 11px;
  }

  .footer-photo-credit a { color: inherit; text-decoration: underline; }

  .footer-email-link:hover {
    color: rgba(255,255,255,0.7);
  }

  .footer-nav-link:hover {
    color: rgba(255,255,255,0.9);
  }

  @media (max-width: 768px) {
    footer p,
    footer a {
      font-size: 13px !important;
      line-height: 1.75 !important;
    }
  }
</style>
