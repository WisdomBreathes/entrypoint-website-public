---
import { homeHero } from '../data/home-hero';

const base = import.meta.env.BASE_URL;
---

<section class="home-hero" aria-labelledby="home-heading">
  <picture class="home-hero-image">
    <source
      type="image/webp"
      media={homeHero.mobile.media}
      srcset={homeHero.mobile.srcset}
      sizes="100vw"
    />
    <img
      src={homeHero.wide.src}
      srcset={homeHero.wide.srcset}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
      alt="Canadian flag flying against a blue sky"
      width="1920"
      height="1210"
    />
  </picture>

  <div class="section-container home-hero-inner">
    <div class="home-hero-content">
      <div class="home-hero-brand">
        <p>Entrypoint Canada</p>
        <span>Regulated immigration services</span>
      </div>
      <h1 id="home-heading">A clear next step in Canadian immigration</h1>
      <p class="home-hero-lead">We assess your options and explain what you need to prepare.</p>
      <div class="home-hero-actions">
        <a href={`${base}contact/`} class="btn-gold">Book a consultation</a>
        <a href="#services-heading" class="home-hero-secondary">Explore services</a>
      </div>
      <p class="home-hero-location">Based in Cambridge, Ontario. Serving Waterloo Region, the GTA, and clients abroad.</p>
    </div>
  </div>
</section>

<style>
  .home-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    background: #242329;
    color: #fff;
  }

  .home-hero-image,
  .home-hero::after {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .home-hero-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left 44%;
  }

  .home-hero::after {
    content: '';
    background: linear-gradient(90deg, rgba(13, 28, 34, 0.93), rgba(13, 28, 34, 0.78) 29%, rgba(13, 28, 34, 0.18) 55%, transparent 77%);
  }

  .home-hero .home-hero-inner {
    width: 100%;
    padding-block: 56px;
  }

  .home-hero-brand {
    margin-bottom: 24px;
  }

  .home-hero-brand p {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 28px;
    font-weight: 600;
    line-height: 1.2;
  }

  .home-hero-brand span {
    display: block;
    margin-top: 4px;
    color: #F0D9A8;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .home-hero h1 {
    max-width: 660px;
    margin: 0 0 16px;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 60px;
    font-weight: 700;
    line-height: 1.1;
    text-wrap: balance;
  }

  .home-hero-lead {
    max-width: 560px;
    color: #F4F1EB;
    font-size: 17px;
    line-height: 1.65;
  }

  .home-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .home-hero-actions a {
    justify-content: center;
  }

  .home-hero-secondary {
    display: inline-flex;
    align-items: center;
    padding: 10px 12px;
    color: #fff;
    font-size: 15px;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.55);
    text-underline-offset: 0.25em;
  }

  .home-hero-secondary:hover {
    text-decoration-color: currentColor;
  }

  .home-hero-location {
    max-width: 520px;
    margin-top: 20px;
    color: #F4F1EB;
    font-size: 13px;
    line-height: 1.6;
  }

  @media (min-width: 768px) {
    .home-hero-content { max-width: 46%; }
    .home-hero-lead { max-width: 360px; }
    .home-hero-location { max-width: 390px; text-wrap: pretty; }
  }

  @media (min-width: 1024px) {
    .home-hero {
      min-height: calc(100vh - var(--site-header-height));
      min-height: calc(100svh - var(--site-header-height));
    }
  }

  @media (max-width: 1023px) {
    .home-hero h1 { font-size: 46px; }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .home-hero h1 { font-size: 32px; }
  }

  @media (width < 768px) {
    .home-hero {
      display: block;
      background: #FFFDFA;
      color: #1C2456;
    }
    .home-hero-image {
      position: relative;
      inset: auto;
      display: block;
      aspect-ratio: 2 / 1;
    }
    .home-hero-image img { object-position: center 28%; }
    /* Bottom fade dissolves the image into the page background — no hard edge */
    .home-hero-image::after {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        linear-gradient(to bottom, transparent 65%, #FFFDFA 100%),
        linear-gradient(90deg, rgba(13, 28, 34, 0.45), rgba(13, 28, 34, 0.15) 20%, transparent 40%);
    }
    .home-hero::after { content: none; }
    .home-hero .home-hero-inner { padding-block: 32px 40px; }
    .home-hero-brand { margin-bottom: 16px; }
    .home-hero-brand p { display: none; }
    /* Service descriptor as a proper eyebrow — small, uppercase, crimson, tracked */
    .home-hero-brand span {
      margin-top: 0;
      color: #8B1A1A;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      line-height: 1.4;
    }
    .home-hero h1 {
      max-width: 520px;
      margin-bottom: 16px;
      font-size: 2.125rem;
      line-height: 1.1;
    }
    .home-hero-lead {
      max-width: 38ch;
      color: #45465E;
      font-size: 1rem;
      line-height: 1.65;
      text-wrap: pretty;
    }
    .home-hero-actions {
      align-items: center;
      gap: 0 24px;
      margin-top: 24px;
    }
    .home-hero-actions .btn-gold { min-height: 44px; padding: 10px 20px; }
    .home-hero-secondary {
      min-height: 44px;
      padding: 0;
      color: #8B1A1A;
      text-decoration-color: rgba(139, 26, 26, 0.45);
    }
    .home-hero-location {
      max-width: 46ch;
      margin-top: 16px;
      color: #45465E;
    }
  }

  @media (max-width: 480px) {
    .home-hero-actions { display: grid; justify-items: start; }
    .home-hero-location { margin-top: 12px; }
  }

  @media (max-width: 419px) {
    .home-hero h1 { font-size: 2rem; }
  }
</style>
