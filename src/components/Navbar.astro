---
const base = import.meta.env.BASE_URL;
const pathFor = (path: string) => `${base}${path}/`.replace(/\/{2,}/g, '/');
const currentPath = Astro.url.pathname;
const navItems = [
  { href: pathFor('services'), label: 'Services', mobileLabel: 'Immigration services' },
  { href: pathFor('programs'), label: 'Programs', mobileLabel: 'Immigration programs' },
  { href: pathFor('about'), label: 'About', mobileLabel: 'About the consultant' },
  { href: pathFor('contact'), label: 'Contact', mobileLabel: 'Contact' },
];
---

<header class="site-header">
  <div class="nav-inner">

    <!-- Logo -->
    <a href={base} class="site-wordmark">
      <img src={`${base}logo-icon.svg`} alt="" width="40" height="40" />
      <div style="display: flex; flex-direction: column; line-height: 1.12; align-items: center;">
        <span style="font-family: 'Playfair Display', Georgia, serif; font-size: 18px; font-weight: 600; color: #1C2456; letter-spacing: 0.01em;">Entrypoint</span>
        <span style="font-family: Inter, sans-serif; font-size: 10px; font-weight: 600; color: #8B1A1A; letter-spacing: 0.18em; text-transform: uppercase; margin-top: 2px;">Canada</span>
      </div>
    </a>

    <!-- Desktop nav links (hidden on mobile) -->
    <nav id="nav-desktop" aria-label="Main navigation">
      {navItems.map(({ href, label }) => (
        <a
          href={href}
          class:list={['nav-link', { 'nav-page-active': currentPath.startsWith(href) }]}
          aria-current={currentPath === href ? 'page' : undefined}
        >{label}</a>
      ))}
      <a href={pathFor('contact')} class="btn-gold" style="font-family: Inter, sans-serif; font-size: 14px; font-weight: 600; color: #1A0F00; background: #C4973A; padding: 9px 20px; border-radius: 8px; text-decoration: none;">
        Book a consultation
      </a>
    </nav>

    <!-- Hamburger button (hidden on desktop) -->
    <button
      id="hamburger"
      type="button"
      aria-expanded="false"
      aria-controls="nav-mobile"
    >
      <span>Menu</span>
      <svg id="icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6"  x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
      <svg id="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="18" y1="6"  x2="6" y2="18"/>
        <line x1="6"  y1="6"  x2="18" y2="18"/>
      </svg>
    </button>

  </div>

  <!-- Mobile dropdown menu -->
  <nav id="nav-mobile" aria-label="Mobile navigation" hidden>
    {navItems.map(({ href, mobileLabel }) => (
      <a
        href={href}
        class:list={['mobile-nav-link', { 'nav-page-active': currentPath.startsWith(href) }]}
        aria-current={currentPath === href ? 'page' : undefined}
      >{mobileLabel}</a>
    ))}
    <a href={pathFor('contact')} class="btn-gold mobile-nav-cta">Book a consultation</a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--site-line);
    background: #FFFDFA;
  }

  .site-wordmark {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 8px;
  }

  .site-wordmark img { flex: none; object-fit: contain; }
  #nav-desktop { display: flex; align-items: center; gap: 32px; white-space: nowrap; }
  #nav-desktop .nav-link { font-size: 15px; font-weight: 400; color: #45465E; }
  #nav-desktop .nav-page-active, #nav-desktop .nav-link:hover { color: var(--site-maroon); }
  #nav-desktop .nav-page-active::after { width: 100%; }

  #hamburger {
    display: none;
    flex: none;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    border: 0;
    background: none;
    color: #1A1A2E;
    font: 600 0.875rem/1.2 'Inter', system-ui, sans-serif;
    cursor: pointer;
  }

  #hamburger svg { flex: none; }
  #hamburger[aria-expanded="false"] #icon-close,
  #hamburger[aria-expanded="true"] #icon-open { display: none; }

  #nav-mobile {
    max-height: calc(100dvh - var(--site-header-height));
    padding: 4px var(--site-gutter) 16px;
    border-top: 1px solid var(--site-line);
    overflow-y: auto;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    min-height: 48px;
    border-bottom: 1px solid var(--site-line);
    color: #1A1A2E;
    font-size: 0.9375rem;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.nav-page-active {
    color: var(--site-maroon);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .mobile-nav-cta { min-height: 44px; margin-top: 12px; padding: 10px 16px; }

  @media (min-width: 768px) and (max-width: 1366px) {
    #nav-desktop { gap: 24px; }

    #nav-desktop .nav-link { font-size: 16px; }

    #nav-desktop .btn-gold {
      font-size: 15px !important;
      padding: 10px 18px !important;
    }
  }

  @media (width < 768px) {
    #nav-desktop { display: none; }
    #hamburger { display: flex; }
  }

  @media (min-width: 768px) {
    #nav-mobile { display: none; }
  }
</style>

<script>
  const hamburger = document.getElementById('hamburger');
  const navMobile = document.getElementById('nav-mobile');

  if (hamburger && navMobile) {
    const setOpen = (open: boolean) => {
      navMobile.hidden = !open;
      hamburger.setAttribute('aria-expanded', String(open));
    };

    hamburger.addEventListener('click', () => setOpen(navMobile.hidden));
    navMobile.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !navMobile.hidden) {
        setOpen(false);
        hamburger.focus();
      }
    });
    window.matchMedia('(min-width: 768px)').addEventListener('change', ({ matches }) => {
      if (matches) setOpen(false);
    });
  }
</script>
