---
import HomeSectionIntro from './HomeSectionIntro.astro';

const base = import.meta.env.BASE_URL;
// ServicesGrid — homepage service index, 5 service entries + 1 CTA

const services = [
  {
    title: 'Permanent residence',
    description: 'Express Entry, Federal Skilled Worker, Canadian Experience Class, and Provincial Nominee Program.',
    label: ['Permanent', 'residence'],
    href: `${base}services/#permanent-residency`,
  },
  {
    title: 'Family sponsorship',
    description: 'Sponsorship for spouses, partners, and dependent children, and related open work permit options.',
    label: ['Sponsor', 'family'],
    href: `${base}services/#family-sponsorship`,
  },
  {
    title: 'Study and work permits',
    description: 'Study permits, post-graduation work permits (PGWP), LMIA, and employer-specific work permits.',
    label: ['Study or', 'work'],
    href: `${base}services/#work-study`,
  },
  {
    title: 'Canadian citizenship',
    description: 'Canadian citizenship applications, test preparation, and ceremony guidance.',
    label: ['Citizenship'],
    href: `${base}services/#citizenship`,
  },
  {
    title: 'Refugee and humanitarian matters',
    description: 'Refugee protection claims, protected person applications, and humanitarian and compassionate grounds.',
    label: ['Refugee', 'and H&C'],
    href: `${base}services/#refugee`,
  },
] as const;

const guides = [
  { slug: 'oinp', label: 'Ontario Immigrant Nominee Program (OINP)' },
  { slug: 'pgwp', label: 'Post-graduation work permit (PGWP)' },
  { slug: 'spousal-sponsorship', label: 'Spousal and dependent child sponsorship' },
];
---

<section style="background: #FAF7F2;" aria-labelledby="services-heading">

  <div class="section-container">

    <HomeSectionIntro
      id="services-heading"
      label="What we do"
      title="Immigration services for individuals and families"
      description="Whether you are applying for the first time or facing a more complex matter, we help you understand the requirements and the options available to you."
    />

    <!-- Service index -->
    <div class="home-services-index">
      {services.map((service, index) => (
        <a
          href={service.href}
          class="home-service-entry"
        >
          <div class="home-service-meta">
            <span class="home-service-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <span class="home-service-label">
              {service.label.map((line) => <span>{line}</span>)}
            </span>
          </div>

          <div class="home-service-copy">
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </div>

          <span class="home-service-link">View service</span>
        </a>
      ))}

      <a
        href={`${base}contact/`}
        class="home-service-entry home-service-entry-cta"
      >
        <div class="home-service-meta">
          <span class="home-service-number" aria-hidden="true">06</span>
          <span class="home-service-label">
            <span>First</span>
            <span>review</span>
          </span>
        </div>

        <div class="home-service-copy">
          <h3>Not sure which service fits?</h3>
          <p>
            Start with a consultation to review your options before deciding how to proceed.
          </p>
        </div>

        <span class="home-service-link">Book a consultation</span>
      </a>

    </div>

    <nav class="home-program-guides" aria-labelledby="home-program-guides-heading">
      <div class="home-program-guides-header">
        <h3 id="home-program-guides-heading">Program guides</h3>
        <p class="home-program-guides-desc">Still researching? Start with <a href={`${base}programs/`}>how to immigrate to Canada</a>.</p>
      </div>
      <ul role="list">
        {guides.map(({ slug, label }) => (
          <li><a href={`${base}programs/${slug}/`}>{label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</section>

<style>
  .home-program-guides {
    margin-top: 48px;
    background: #F4F1EB;
    border: 1px solid #E0D9CE;
    border-radius: 12px;
    padding: 28px 28px 24px;
  }
  .home-program-guides-header {
    display: flex;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .home-program-guides h3 {
    color: #1C2456;
    font: 600 1.0625rem/1.25 'Inter', sans-serif;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .home-program-guides-desc {
    color: #5C5C7A;
    font-size: 0.875rem;
    margin: 0;
  }
  .home-program-guides-desc a {
    color: #8B1A1A;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .home-program-guides ul {
    display: grid;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 8px;
  }
  .home-program-guides li a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    background: #FFFDFA;
    border: 1px solid #E8E3D9;
    border-radius: 8px;
    color: #1C2456;
    font-family: Inter, sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s;
  }
  .home-program-guides li a::after {
    content: '';
    flex: none;
    width: 0.5em;
    height: 0.5em;
    border-top: 1.5px solid #8B1A1A;
    border-right: 1.5px solid #8B1A1A;
    transform: rotate(45deg);
    opacity: 0.7;
  }
  .home-program-guides li a:hover {
    background: #ffffff;
    border-color: #C4973A;
  }
  .home-program-guides li a:hover::after { opacity: 1; }
  @media (min-width: 768px) {
    .home-program-guides ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .home-program-guides li {
      display: flex;
    }
    .home-program-guides li a {
      flex: 1;
    }
    .home-program-guides {
      padding: 28px 32px 28px;
    }
    .home-program-guides-header {
      margin-bottom: 16px;
    }
  }
  @media (max-width: 767px) {
    .home-program-guides {
      padding: 20px 20px 20px;
      margin-top: 32px;
    }
  }

  .home-services-index {
    display: grid;
    grid-template-columns: 1fr;
    border: 1px solid #E8E3D9;
    border-radius: 12px;
    overflow: hidden;
    background: rgba(255,255,255,0.36);
  }

  .home-service-entry {
    display: grid;
    grid-template-columns: minmax(86px, 0.32fr) minmax(0, 1fr);
    grid-template-rows: auto auto auto;
    column-gap: 18px;
    row-gap: 0;
    align-items: start;
    min-height: 228px;
    padding: 24px;
    background: rgba(255,255,255,0.44);
    border-right: 1px solid #E8E3D9;
    border-bottom: 1px solid #E8E3D9;
    color: inherit;
    text-decoration: none;
    transition: background-color 0.18s ease;
  }

  .home-service-entry:hover {
    background: #ffffff;
  }

  .home-service-entry:focus-visible {
    outline: 2px solid #1C2456;
    outline-offset: -2px;
  }

  .home-service-meta {
    display: flex;
    grid-row: 1 / -1;
    min-width: 0;
    flex-direction: column;
    gap: 8px;
  }

  .home-service-number,
  .home-service-label {
    display: block;
  }

  .home-service-number {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 28px;
    font-weight: 600;
    line-height: 1;
    color: rgba(61,18,21,0.32);
    letter-spacing: 0;
  }

  .home-service-label {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 600;
    line-height: 1.35;
    text-transform: uppercase;
    color: #8B1A1A;
  }

  .home-service-label span {
    display: block;
    white-space: nowrap;
  }

  .home-service-copy {
    grid-column: 2;
    display: contents;
    min-width: 0;
  }

  .home-service-copy h3 {
    grid-column: 2;
    grid-row: 1;
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.35;
    color: #1A1A2E;
    min-height: 44px;
    margin: 0;
  }

  .home-service-copy p {
    grid-column: 2;
    grid-row: 2;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 300;
    line-height: 1.7;
    color: #45465E;
    min-height: 82px;
    margin: 2px 0 0;
  }

  .home-service-link {
    display: flex;
    align-items: center;
    gap: 0.48em;
    grid-column: 2;
    grid-row: 3;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.2;
    color: #8B1A1A;
    margin-top: 14px;
  }

  .home-service-link::after {
    content: '';
    flex: none;
    width: 0.42em;
    height: 0.42em;
    border-top: 1.5px solid currentColor;
    border-right: 1.5px solid currentColor;
    transform: translateY(-0.06em) rotate(45deg);
  }

  .home-service-entry-cta {
    background: #3D1215;
  }

  .home-service-entry-cta:hover {
    background: #2C0D0F;
  }

  .home-service-entry-cta .home-service-number {
    color: rgba(196,151,58,0.62);
  }

  .home-service-entry-cta .home-service-label,
  .home-service-entry-cta .home-service-link {
    color: #C4973A;
  }

  .home-service-entry-cta .home-service-copy h3 {
    color: #ffffff;
  }

  .home-service-entry-cta .home-service-copy p {
    color: rgba(255,255,255,0.74);
  }

  @media (min-width: 640px) {
    .home-services-index {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 1fr;
    }

    .home-service-entry:nth-child(2n) {
      border-right: 0;
    }
  }

  @media (min-width: 1024px) {
    .home-services-index {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .home-service-entry:nth-child(2n) {
      border-right: 1px solid #E8E3D9;
    }

    .home-service-entry:nth-child(3n) {
      border-right: 0;
    }

    .home-service-entry:nth-last-child(-n + 3) {
      border-bottom: 0;
    }
  }

  @media (max-width: 768px) {
    .home-service-entry {
      grid-template-columns: 64px minmax(0, 1fr);
      grid-template-rows: auto auto auto;
      min-height: 0;
      padding: 20px;
    }

    .home-service-copy h3 {
      font-size: 16px !important;
      line-height: 1.3 !important;
      min-height: 0;
      margin-bottom: 10px;
    }

    .home-service-copy p {
      font-size: 14px !important;
      line-height: 1.75 !important;
      min-height: 0;
    }

    .home-service-link {
      font-size: 13px !important;
    }
  }

  @media (max-width: 639px) {
    .home-service-entry {
      border-right: 0;
    }

    .home-service-entry:last-child {
      border-bottom: 0;
    }
  }

  @supports (grid-template-rows: subgrid) {
    @media (min-width: 640px) {
      .home-services-index { grid-auto-rows: auto; }
      .home-service-entry { grid-row: span 3; grid-template-rows: subgrid; min-height: 0; }
      .home-service-copy h3 { min-height: 0; margin-bottom: 8px; }
      .home-service-copy p { min-height: 0; }
    }
  }
</style>
