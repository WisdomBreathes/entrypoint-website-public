---
import HomeSectionIntro from './HomeSectionIntro.astro';

const faqs = [
  {
    question: 'Can I book a consultation if I live outside Cambridge?',
    answer:
      'Yes. Entrypoint Canada is based in Cambridge, Ontario, and serves clients in Kitchener, Waterloo, the Greater Toronto Area, and outside Canada. You do not need to live in Cambridge to request a consultation.',
  },
  {
    question: 'Can I apply for a study permit after a previous refusal?',
    answer:
      'Sometimes, yes. The key issue is not simply reapplying, but understanding why the refusal happened and whether the new application meaningfully addresses those concerns. For study permit files, refusal reasons often involve finances, program relevance, travel history, or temporary intent. A fresh application should be built around the actual refusal notes and the current facts of your case.',
  },
  {
    question: 'Can I restore my status in Canada after it has expired?',
    answer:
      'In some situations, yes, but restoration depends on timing and the type of status that was lost. In many cases, restoration must be requested within 90 days of losing temporary resident status, and the person must have complied with the conditions of their previous stay. The supporting documents and next application strategy matter, so this should be reviewed quickly.',
  },
  {
    question: 'Can I move from visitor status to a work permit or another temporary status?',
    answer:
      'Most visitors cannot apply for a work permit from inside Canada unless they qualify for a specific exception. Visitor status does not authorize work, and a job offer or an LMIA does not by itself make you eligible to apply from inside Canada. Check IRCC\'s rules before applying or starting work.',
    source: { label: 'IRCC eligibility for in-Canada work permit applications', href: 'https://www.canada.ca/en/immigration-refugees-citizenship/services/work-canada/permit-inside/eligibility.html' },
  },
  {
    question: 'Is my CRS score high enough for Express Entry right now?',
    answer:
      'No single CRS score guarantees an invitation. Cutoffs vary by round, and you still need to meet the criteria for that round. Since November 3, 2026, IRCC has used new rules to score Canadian work experience and qualifying job offers in eligible high-wage occupations. Not every valid job offer earns CRS points.',
    source: { label: 'IRCC Express Entry scoring changes', href: 'https://www.canada.ca/en/immigration-refugees-citizenship/services/immigrate-canada/express-entry/changes.html' },
  },
  {
    question: 'How long does family sponsorship usually take?',
    answer:
      'Processing times can vary based on the application type, where the applicant is applying from, whether additional review is required, and current IRCC volumes. Inland and overseas files can move differently. Sponsorship cases should be prepared carefully from the start because missing relationship evidence, incomplete forms, or avoidable follow-up requests often slow the process down.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<section style="background: #ffffff;" aria-labelledby="faq-heading">
  <div class="section-container">
    <HomeSectionIntro
      id="faq-heading"
      title="Common questions about Canadian immigration"
      description="These answers are a starting point. Your options depend on your circumstances and the rules in effect when you apply."
    />

    <div class="home-faq-list">
        {faqs.map((faq, index) => (
          <details
            class="faq-item"
            style="background: #FAF7F2; border: 1px solid #E8E3D9; border-radius: 8px; padding: 0 20px;"
            open={index === 0}
          >
            <summary style="list-style: none; cursor: pointer; padding: 18px 0; display: flex; align-items: center; justify-content: space-between; gap: 16px;">
              <span style="font-family: 'Playfair Display', Georgia, serif; font-size: 20px; font-weight: 600; color: #1A1A2E; line-height: 1.35;">
                {faq.question}
              </span>
              <span class="faq-plus" style="flex-shrink: 0; width: 28px; height: 28px; border-radius: 50%; background: #ffffff; border: 1px solid #D9D2C5; display: inline-flex; align-items: center; justify-content: center;">
                <span class="faq-plus-icon" aria-hidden="true"></span>
              </span>
            </summary>
            <div style="padding: 0 0 18px; border-top: 1px solid #E8E3D9;">
              <p style="font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 300; color: #42445A; line-height: 1.85; padding-top: 16px;">
                {faq.answer}
                {faq.source && <> <a href={faq.source.href}>{faq.source.label}</a>.</>}
              </p>
            </div>
          </details>
        ))}
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>

<style>
  .faq-item p a {
    color: #1C2456;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .home-faq-list {
    display: grid;
    gap: 12px;
  }

  .faq-item {
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .faq-item[open] {
    background: #ffffff !important;
    border-color: #DDD5C8 !important;
  }

  .faq-item[open] .faq-plus {
    transform: rotate(45deg);
  }

  .faq-plus {
    transition: transform 0.2s ease;
    transform-origin: center;
  }

  .faq-plus-icon {
    position: relative;
    display: block;
    width: 12px;
    height: 12px;
  }

  .faq-plus-icon::before,
  .faq-plus-icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    background: #8B1A1A;
    border-radius: 999px;
    transform: translate(-50%, -50%);
  }

  .faq-plus-icon::before {
    width: 12px;
    height: 1.5px;
  }

  .faq-plus-icon::after {
    width: 1.5px;
    height: 12px;
  }

  @media (max-width: 768px) {
    .faq-item summary span:first-child {
      font-size: 18px !important;
    }

    .faq-item p {
      font-size: 15px !important;
      line-height: 1.75 !important;
    }
  }
</style>
