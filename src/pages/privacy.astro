---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL;
const privacyEmail = { label: 'Email our office about privacy', href: 'mailto:info@entrypointcanada.com' };
const privacyPhone = { label: 'Call 647-906-0011', href: 'tel:+16479060011' };

const sections = [
  {
    id: 'who-we-are',
    title: '1. Who we are',
    content: `Entrypoint Canada Immigration Services is operated by Sabiha Iftakhar, a Registered Canadian Immigration Consultant (RCIC) and member in good standing with the College of Immigration and Citizenship Consultants (CICC).

Our contact details are:

• Business name: Entrypoint Canada Immigration Services
• Consultant: Sabiha Iftakhar, RCIC
• Address: 37 Faith St, Cambridge, ON

This privacy policy applies to all personal information collected through our website (entrypointcanada.com) and through direct communications with our office.`,
    links: [privacyEmail, privacyPhone],
  },
  {
    id: 'information-collected',
    title: '2. What information we collect',
    content: `The website contact form collects the details you enter:

• Your full name
• Your email address
• Your phone number, if you choose to provide it
• The service you select and the details you include in your message

The form also sends the contact page address and browser information when you submit it. Website and form providers may record technical data, such as an IP address, to operate and secure their services.

If you contact our office directly or attend a consultation, we may receive other details you choose to share. Please do not send passport numbers, government identifiers, or documents through the website form.`,
  },
  {
    id: 'how-we-use',
    title: '3. How we use your information',
    content: `We use the personal information you provide solely for the following purposes:

• To respond to your inquiry or message
• To schedule and conduct immigration consultations
• To assess your eligibility for immigration pathways and provide regulated advice
• To communicate with you about your file, next steps, or follow-up matters
• To comply with our professional obligations as a regulated RCIC under CICC guidelines

We do not use your information for marketing purposes, and we do not send unsolicited communications. You will only hear from us in direct response to your inquiry or as part of an active consultation relationship.`,
  },
  {
    id: 'how-we-protect',
    title: '4. How we protect your information',
    content: `As a regulated immigration consultant, Sabiha Iftakhar is bound by the CICC Code of Professional Conduct, which includes binding confidentiality obligations. All client information is treated with the strictest professional confidence.

Specific protections include:

• Your information is not sold to third parties
• We store and process inquiry and client records in Canada
• Service providers may process information on our behalf to host the website or deliver inquiries
• Other disclosures are limited to those you authorize or those permitted or required by law and our professional obligations
• Consultations and file materials are handled in a secure, private environment
• Electronic communications and stored files are protected with appropriate security measures

If you have concerns about how your information is handled, contact our office.`,
    links: [privacyEmail],
  },
  {
    id: 'data-retention',
    title: '5. Data retention',
    content: `We keep website inquiries while we respond and follow up. If an inquiry does not lead to a consultation or other services, we close it and securely delete the inquiry record and related copies we control when they are no longer needed, unless we are required to keep them.

If you go ahead with a consultation or engage us for other services, we keep the information needed for that work. We handle those records separately and retain them as required by law and professional obligations.

You may request deletion of your information at any time (see Section 6 below), subject to any overriding legal or regulatory retention requirements.`,
  },
  {
    id: 'your-rights',
    title: '6. Your rights',
    content: `You have the following rights with respect to your personal information:

• Right of access — you may request a copy of the personal information we hold about you
• Right of correction — you may ask us to correct any inaccurate or incomplete information
• Deletion requests — you may ask us to delete your information, subject to legal and regulatory retention obligations
• Withdrawal of consent — you may ask to withdraw consent, subject to legal or contractual restrictions and reasonable notice

Please contact us in writing to make a request. We respond in accordance with applicable Canadian privacy law, including the Personal Information Protection and Electronic Documents Act (PIPEDA).`,
    links: [privacyEmail],
  },
  {
    id: 'contact-privacy',
    title: '7. Privacy inquiries and complaints',
    content: `Contact our office if you have a question or complaint about how we handle personal information. You can also write to Sabiha Iftakhar, RCIC, at 37 Faith St, Cambridge, ON. If you are not satisfied with our response, you can contact the Office of the Privacy Commissioner of Canada.`,
    links: [
      privacyEmail,
      privacyPhone,
      { label: 'Office of the Privacy Commissioner of Canada', href: 'https://www.priv.gc.ca/en/report-a-concern/' },
    ],
  },
];
---

<Layout
  title="Privacy Policy — Entrypoint Canada"
  description="Read the privacy policy for Entrypoint Canada Immigration Services, including how personal information is collected, used, protected, and retained."
>
  <Navbar />
  <main id="main-content">

    <!-- Page hero — clean burgundy, no background image -->
    <section style="background: #3D1215; padding: 72px 0 64px;">
      <div class="page-hero-inner">
        <a href={base} class="page-back-link" style="display: inline-flex; align-items: center; gap: 6px; font-family: Inter, sans-serif; font-size: 13px; color: rgba(255,255,255,0.6); text-decoration: none; margin-bottom: 24px; transition: color 0.15s;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
          Back to home
        </a>
        <p style="font-family: Inter, sans-serif; font-size: 10px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #C4973A; margin-bottom: 12px;">
          Legal
        </p>
        <h1 style="font-family: 'Playfair Display', Georgia, serif; font-size: clamp(32px, 4vw, 48px); font-weight: 700; color: #ffffff; line-height: 1.15; margin-bottom: 12px;">
          Privacy Policy
        </h1>
        <p style="font-family: Inter, sans-serif; font-size: 16px; font-weight: 300; color: rgba(255,255,255,0.72); margin-bottom: 20px; line-height: 1.6;">
          How personal information is collected, used, stored, and protected through this website and during consultations.
        </p>
        <p style="font-family: Inter, sans-serif; font-size: 13px; font-weight: 300; color: rgba(255,255,255,0.65);">
          Last updated: <time datetime="2026-11-08">November 8, 2026</time>
        </p>
      </div>
    </section>

    <!-- Content -->
    <section style="background: #FAF7F2;">
      <div class="section-container">
        <div class="legal-layout">

          <!-- Table of contents (sidebar on desktop) -->
          <aside class="legal-contents">
            <div class="legal-contents-panel">
              <p style="font-family: Inter, sans-serif; font-size: 10px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #8B1A1A; margin-bottom: 16px;">
                Contents
              </p>
              <nav aria-label="Privacy policy sections">
                <ol style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 2px;">
                  {sections.map((s) => (
                    <li>
                      <a href={`#${s.id}`}
                         class="legal-section-link"
                         style="display: block; font-family: Inter, sans-serif; font-size: 13px; font-weight: 400; color: #45465E; text-decoration: none; padding: 6px 8px; border-radius: 6px; transition: background 0.1s, color 0.1s; line-height: 1.4;"
                         >
                        {s.title}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            </div>
          </aside>

          <!-- Policy sections -->
          <div style="display: flex; flex-direction: column; gap: 48px;">

            <!-- Intro paragraph -->
            <p style="font-family: Inter, sans-serif; font-size: 15px; font-weight: 300; color: #3D3D5C; line-height: 1.8; border-left: 3px solid #C4973A; padding-left: 20px;">
              This policy explains what Entrypoint Canada Immigration Services collects when you contact us, how we use and protect it, and how to ask about your information.
            </p>

            {sections.map((section) => (
              <article id={section.id} class="legal-section">
                <h2 style="font-family: 'Playfair Display', Georgia, serif; font-size: clamp(20px, 2.5vw, 26px); font-weight: 700; color: #1A1A2E; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid #E8E3D9;">
                  {section.title}
                </h2>
                <div style="display: flex; flex-direction: column; gap: 12px;">
                  {section.content.split('\n\n').map((block) => (
                    block.trim().startsWith('•') ? (
                      <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px;">
                        {block.split('\n').filter(l => l.trim().startsWith('•')).map((item) => (
                          <li style="display: flex; align-items: flex-start; gap: 10px;">
                            <span style="width: 5px; height: 5px; border-radius: 50%; background: #8B1A1A; flex-shrink: 0; margin-top: 8px;"></span>
                            <span style="font-family: Inter, sans-serif; font-size: 14px; font-weight: 300; color: #3D3D5C; line-height: 1.7;">{item.replace(/^•\s*/, '')}</span>
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <p style="font-family: Inter, sans-serif; font-size: 14px; font-weight: 300; color: #3D3D5C; line-height: 1.8;">{block.trim()}</p>
                    )
                  ))}
                  {section.links && (
                    <ul class="legal-action-links" role="list">
                      {section.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
                    </ul>
                  )}
                </div>
              </article>
            ))}

            <!-- Footer note -->
            <div style="background: white; border: 1px solid #E8E3D9; border-left: 3px solid #3D1215; border-radius: 10px; padding: 24px 28px; margin-top: 8px;">
              <p style="font-family: Inter, sans-serif; font-size: 13px; font-weight: 300; color: #45465E; line-height: 1.7;">
                The date at the top of this page shows when we last revised this policy. For questions, contact us at
                <a href="mailto:info@entrypointcanada.com" style="color: #3D1215; text-decoration: underline; font-weight: 400;">info@entrypointcanada.com</a>.
              </p>
            </div>

          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<style>
  .page-back-link:hover {
    color: rgba(255,255,255,0.9);
  }

  .legal-section-link:hover {
    background: #FAF7F2;
    color: #3D1215;
  }

  @media (max-width: 768px) {
    .page-hero-inner h1 { font-size: 32px !important; }
  }
</style>
