---
import ProgramDetailPage from '../../components/ProgramDetailPage.astro';
---

<ProgramDetailPage
  title="Ontario Immigrant Nominee Program (OINP) | Entrypoint Canada"
  description="Learn about Ontario's Workforce Priority stream, who may qualify, and how to check the current Ontario Immigrant Nominee Program requirements before applying."
  kicker="Ontario Immigration"
  heading="Ontario Immigrant Nominee Program (OINP)"
  summary="The Ontario Immigrant Nominee Program allows Ontario to nominate eligible applicants for permanent residence. Learn how the Ontario Workforce Priority stream works and what changed in 2026."
  badges={[
    'Ontario provincial nominee program',
    'Reviewed against Ontario.ca and Ontario e-Laws',
    'Relevant for Cambridge, Kitchener-Waterloo, and Ontario applicants',
    'Program details can change quickly',
  ]}
  sections={[
    {
      title: 'What changed in Ontario',
      body: 'Ontario replaced the former eight streams with the Ontario Workforce Priority stream in June 2026. On August 4, 2026, Ontario opened the new stream to expressions of interest. The province will not issue further invitations under the former streams.',
      bullets: [
        'Ontario Workforce Priority: TEER 0-3 category',
        'Ontario Workforce Priority: TEER 4-5 category',
        'Ontario Workforce Priority: self-employed physician category',
        'Applications already received under the former framework are assessed against the requirements in place at the time of application',
      ],
    },
    {
      title: 'Who should review this pathway',
      body: 'The Ontario Workforce Priority stream may be relevant to people with qualifying Ontario job offers or eligible self-employed physicians. Previous Ontario work experience on its own does not qualify someone for this stream.',
      bullets: [
        'Applicants planning to live and work in Ontario',
        'Workers and employers affected by the OINP redesign',
        'People who previously expected to use an old OINP stream',
      ],
    },
    {
      title: 'How Entrypoint Canada reviews OINP files',
      body: 'Entrypoint Canada reviews the profile, work history, occupation, language results, immigration status, employer documents where applicable, and timing. The goal is to identify whether a current Ontario route is realistic or whether another pathway such as Express Entry, CEC, or a work permit strategy should be considered.',
      bullets: [
        'Profile review against current Ontario and IRCC requirements',
        'Assessment of timing, portal availability, and document readiness',
        'Alternative pathway review where OINP is not currently available',
      ],
    },
  ]}
  noteTitle="Current OINP note"
  noteBody="An expression of interest is not an application for nomination. Check Ontario's current stream criteria and application process before registering."
  sourceLinks={[
    { label: 'Ontario Workforce Priority stream criteria', href: 'https://www.ontario.ca/page/ontario-workforce-priority-stream' },
    { label: 'Ontario OINP application process', href: 'https://www.ontario.ca/page/oinp-application-process' },
    { label: 'Ontario 2026 OINP updates', href: 'https://www.ontario.ca/page/2026-ontario-immigrant-nominee-program-updates' },
    { label: 'O. Reg. 422/17', href: 'https://www.ontario.ca/laws/regulation/170422' },
    { label: 'O. Reg. 421/17', href: 'https://www.ontario.ca/laws/regulation/170421' },
  ]}
  relatedLinks={[
    { label: 'Programs overview', href: '/programs/' },
    { label: 'PGWP pathway', href: '/programs/pgwp/' },
    { label: 'Book a consultation', href: '/contact/' },
  ]}
  reviewedOn="2026-11-07"
  schemaName="Ontario Immigrant Nominee Program (OINP)"
  schemaTopics={[
    'Ontario Immigrant Nominee Program',
    'Ontario Workforce Priority Stream',
    'Provincial Nominee Program',
    'Ontario immigration',
    'Cambridge immigration consultant',
  ]}
/>
