---
import ProgramDetailPage from '../../components/ProgramDetailPage.astro';
---

<ProgramDetailPage
  title="Spousal, Partner & Child Sponsorship | Entrypoint Canada"
  description="Learn what to consider when sponsoring a spouse, partner, or dependent child for Canadian permanent residence, including eligibility and relationship evidence."
  kicker="Family Sponsorship"
  heading="Spousal, Partner, and Dependent Child Sponsorship"
  summary="Eligible Canadian citizens, permanent residents, and people registered under the Indian Act may sponsor a spouse, common-law partner, conjugal partner, or dependent child for permanent residence."
  badges={[
    'Sponsors must be at least 18',
    'The application class depends on the relationship and living arrangements',
    'Sponsorship includes a financial undertaking',
    'Work permits are assessed separately',
  ]}
  sections={[
    {
      title: 'Who can sponsor a family member',
      body: 'A sponsor must be at least 18 and generally live in Canada. A Canadian citizen living abroad may sponsor if they can show they will return to live in Canada when the sponsored person becomes a permanent resident. A permanent resident living abroad cannot sponsor from outside Canada.',
      bullets: [
        'Check the sponsor eligibility rules and any restrictions from previous sponsorships',
        'Understand the financial responsibilities of signing a sponsorship undertaking',
        'Most spouse, partner and dependent child cases have no minimum income requirement, but exceptions apply',
      ],
    },
    {
      title: 'Family Class or in-Canada class?',
      body: 'Spouses and common-law partners living together in Canada may qualify for the in-Canada class. The Family Class is used for conjugal partners and dependent children sponsored on their own, and may also apply to a spouse or common-law partner, including one living outside Canada.',
      bullets: [
        'Check where the applicant will live while the file is processed',
        'Review temporary status and travel separately from the sponsorship application',
        'Some sponsored family members in Canada may qualify for a separate open work permit',
      ],
    },
    {
      title: 'Documents that show the relationship',
      body: 'Use the IRCC checklist for your relationship and country of residence. For example, proof that you live together may matter in a common-law application. If you are sponsoring a child, check whether IRCC asks for custody documents or consent from the other parent.',
      bullets: [
        'Check that names and dates match across forms and documents',
        'Include the required translations and country-specific documents',
        'Explain missing documents instead of leaving gaps in the application',
      ],
    },
  ]}
  noteTitle="Check your temporary status separately"
  noteBody="Submitting a sponsorship application does not, by itself, give the applicant temporary status or permission to work. Check IRCC's separate rules before a permit expires or before starting work."
  sourceLinks={[
    { label: 'Canada.ca sponsor your spouse, partner, or child', href: 'https://www.canada.ca/en/immigration-refugees-citizenship/services/immigrate-canada/family-sponsorship/spouse-partner-children.html' },
    { label: 'IRCC sponsorship guide (IMM 5289)', href: 'https://www.canada.ca/en/immigration-refugees-citizenship/services/application/application-forms-guides/guide-5289-sponsor-your-spouse-common-law-partner-conjugal-partner-dependent-child-complete-guide.html' },
    { label: 'IRCC open work permits for sponsored family members', href: 'https://www.canada.ca/en/immigration-refugees-citizenship/services/immigrate-canada/family-sponsorship/spouse-partner-children/spouse-common-law-partner-canada-open-work-permit.html' },
  ]}
  relatedLinks={[
    { label: 'Programs overview', href: '/programs/' },
    { label: 'Family sponsorship services', href: '/services/#family-sponsorship' },
    { label: 'Book a consultation', href: '/contact/' },
  ]}
  reviewedOn="2026-11-08"
  schemaName="Spousal, Partner, and Dependent Child Sponsorship"
  schemaTopics={[
    'Spousal sponsorship',
    'Common-law partner sponsorship',
    'Family sponsorship Canada',
    'Dependent child sponsorship',
    'Cambridge immigration consultant',
  ]}
/>
