---
import ProgramDetailPage from '../../components/ProgramDetailPage.astro';
---

<ProgramDetailPage
  title="Post-Graduation Work Permit (PGWP) | Entrypoint Canada"
  description="Learn how your school, study program, status, and graduation timing can affect your Canadian post-graduation work permit (PGWP) application."
  kicker="Student Pathways"
  heading="Post-Graduation Work Permit (PGWP)"
  summary="A post-graduation work permit lets eligible graduates work in Canada. Check whether your specific program qualifies before you enrol. If you have already finished, check your study permit status and your deadline to apply."
  badges={[
    'Not every program at a designated school qualifies',
    'Apply within 180 days of confirmed completion',
    'Language and field-of-study rules depend on the program',
    'Applying does not always let you work while you wait',
  ]}
  sections={[
    {
      title: 'What a PGWP is',
      body: 'A post-graduation work permit is an open work permit for eligible graduates. A school being a designated learning institution does not mean all of its programs qualify. Verify the specific program before accepting an offer.',
      bullets: [
        'Check the minimum program length and full-time study requirements, including any exceptions',
        'Apply within 180 days of receiving confirmation that you completed your program',
        'Check whether your study permit and current status meet IRCC requirements',
      ],
    },
    {
      title: 'Language and field-of-study requirements',
      body: 'IRCC generally requires language results in all four skills: at least CLB or NCLC 7 for bachelor\'s, master\'s, doctoral and other university programs, and 5 for other college, polytechnic or non-university programs. Graduates of eligible flight schools have separate rules.',
      bullets: [
        'Bachelor\'s, master\'s and doctoral graduates do not have a field-of-study requirement',
        'Other programs generally need an eligible field of study if the study permit application was submitted on or after November 1, 2024',
        'IRCC froze the eligible fields list for 2026; check your program\'s six-digit classification (CIP) code if the requirement applies',
      ],
    },
    {
      title: 'Working while you wait for a decision',
      body: 'Applying for a PGWP does not automatically let you work. IRCC requires a valid study permit when you apply, a completed program, and prior eligibility to work off campus without exceeding the permitted hours.',
      bullets: [
        'Keep your program completion letter and transcripts',
        'If your study permit has expired, check the separate rules and deadlines for restoring status',
        'Work authorization and permanent residence eligibility are assessed separately',
      ],
    },
  ]}
  noteTitle="Separate rules while you study"
  noteBody="Since January 1, 2026, applicants to degree-granting master's and doctoral programs at public designated learning institutions generally do not need a provincial or territorial attestation letter. Quebec has separate requirements. Since April 1, eligible post-secondary students do not need a separate co-op work permit for required, school-approved placements. Neither change determines PGWP eligibility."
  sourceLinks={[
    { label: 'IRCC PGWP eligibility', href: 'https://www.canada.ca/en/immigration-refugees-citizenship/services/study-canada/work/after-graduation/eligibility.html' },
    { label: 'IRCC eligible fields of study', href: 'https://www.canada.ca/en/immigration-refugees-citizenship/services/study-canada/work/after-graduation/eligibility/field-of-study.html' },
    { label: 'IRCC PGWP application and restoration', href: 'https://www.canada.ca/en/immigration-refugees-citizenship/services/study-canada/work/after-graduation/apply.html' },
    { label: 'IRCC work authorization after applying', href: 'https://www.canada.ca/en/immigration-refugees-citizenship/services/study-canada/work/after-graduation/after-you-apply.html' },
    { label: 'IRCC study permits for graduate students', href: 'https://www.canada.ca/en/immigration-refugees-citizenship/services/study-canada/graduate-student/how-to-apply.html' },
    { label: 'IRCC student work placement eligibility', href: 'https://www.canada.ca/en/immigration-refugees-citizenship/services/study-canada/work/intern.html' },
  ]}
  relatedLinks={[
    { label: 'Programs overview', href: '/programs/' },
    { label: 'Study and work permit services', href: '/services/#work-study' },
    { label: 'Book a consultation', href: '/contact/' },
  ]}
  reviewedOn="2026-11-08"
  schemaName="Post-Graduation Work Permit (PGWP)"
  schemaTopics={[
    'Post-Graduation Work Permit',
    'Study Permit',
    'International students in Canada',
    'Canadian work experience',
    'Cambridge immigration consultant',
  ]}
/>
