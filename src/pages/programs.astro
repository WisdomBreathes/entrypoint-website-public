---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL;

const programsPageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://entrypointcanada.com/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'How to Immigrate to Canada',
        item: 'https://entrypointcanada.com/programs/',
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'How to Immigrate to Canada',
    description: 'Overview of Canadian immigration pathways including Express Entry, Provincial Nominee Program, Ontario Immigrant Nominee Program updates, Canadian Experience Class, post-graduation work permits, LMIA-supported work permits, family sponsorship, and specialist streams.',
    url: 'https://entrypointcanada.com/programs/',
    dateModified: '2026-11-08',
    inLanguage: 'en-CA',
    isPartOf: {
      '@type': 'WebSite',
      name: 'Entrypoint Canada',
      url: 'https://entrypointcanada.com/',
    },
    about: [
      'Express Entry',
      'Provincial Nominee Program',
      'Ontario Immigrant Nominee Program',
      'Canadian Experience Class',
      'Post-Graduation Work Permit',
      'Labour Market Impact Assessment',
      'Family Sponsorship',
      'Francophone Mobility',
      'Entrepreneur Work Permit',
    ],
    mainEntity: {
      '@type': 'ItemList',
      name: 'Immigration pathways covered',
      itemListElement: [
        { name: 'Express Entry' },
        { name: 'Provincial Nominee Program (PNP)' },
        { name: 'Canadian Experience Class' },
        { name: 'Ontario Workforce Priority Stream', url: 'https://entrypointcanada.com/programs/oinp/' },
        { name: 'Study Permit and Post-Graduation Work Permit', url: 'https://entrypointcanada.com/programs/pgwp/' },
        { name: 'Employer Work Permits and LMIA Support' },
        { name: 'Spousal, Partner, and Child Sponsorship', url: 'https://entrypointcanada.com/programs/spousal-sponsorship/' },
        { name: 'C11 Entrepreneur Work Permit' },
        { name: 'C16 Francophone Mobility' },
        { name: 'C44 Postdoctoral Research' },
      ].map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.name,
        ...(item.url ? { url: item.url } : {}),
      })),
    },
  },
];
---

<Layout
  title="How to Immigrate to Canada | Entrypoint Canada"
  description="Compare Canadian permanent residence pathways, including Express Entry, provincial nomination, and family sponsorship. Learn how study and work permits fit into your plans."
  heroImage="programs"
  schema={programsPageSchema}
>
  <Navbar />
  <main id="main-content">

    <!-- Page hero -->
    <section style="position: relative; overflow: hidden; background: #1A0A0A; padding: 56px 0 52px; min-height: 360px; display: flex; align-items: center;">
      <picture>
        <source
          type="image/webp"
          srcset={`${base}images/cole-keister-rydTSO7xB5A-unsplash-800w.webp 800w, ${base}images/cole-keister-rydTSO7xB5A-unsplash-1400w.webp 1400w`}
          sizes="100vw"
        />
        <img
          src={`${base}images/cole-keister-rydTSO7xB5A-unsplash-1400w.webp`}
          alt=""
          aria-hidden="true"
          loading="eager"
          fetchpriority="high"
          decoding="sync"
          width="1400"
          height="2099"
          style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center;"
        />
      </picture>
      <div style="position: absolute; inset: 0; background: rgba(10,5,5,0.65);"></div>
      <div class="page-hero-inner page-hero-copy" style="position: relative; z-index: 1;">
        <a href={base} class="page-back-link" style="display: inline-flex; align-items: center; gap: 6px; font-family: Inter, sans-serif; font-size: 13px; color: rgba(255,255,255,0.6); text-decoration: none; margin-bottom: 24px; transition: color 0.15s;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
          Back to home
        </a>
        <p style="font-family: Inter, sans-serif; font-size: 10px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #C4973A; margin-bottom: 12px;">
          Immigration Programs
        </p>
        <h1 style="font-family: 'Playfair Display', Georgia, serif; font-size: clamp(30px, 4vw, 42px); font-weight: 700; color: #ffffff; line-height: 1.15; margin-bottom: 16px; max-width: 720px;">
          How to immigrate to Canada
        </h1>
        <p style="font-family: Inter, sans-serif; font-size: 17px; font-weight: 300; color: rgba(255,255,255,0.75); line-height: 1.7; max-width: 600px;">
          Moving to Canada permanently is different from coming to study or work. Compare the options below and find the official requirements for the one that fits your plans.
        </p>
      </div>
    </section>

    <section class="programs-start" aria-labelledby="programs-start-heading">
      <div class="section-container">
        <p class="programs-start-eyebrow">Start here</p>
        <h2 id="programs-start-heading">Which pathway fits your goal?</h2>

        <div class="programs-start-grid">

          <div class="programs-start-card">
            <span class="programs-start-tag">Permanent residence</span>
            <h3>Settle in Canada</h3>
            <p>Compare <a href="#economic-pathways">Express Entry and provincial nomination</a>. If your plans are in Ontario, start with the <a href={`${base}programs/oinp/`}>Ontario Immigrant Nominee Program (OINP)</a>.</p>
          </div>

          <div class="programs-start-card">
            <span class="programs-start-tag">Family sponsorship</span>
            <h3>Join family in Canada</h3>
            <p>Read about <a href={`${base}programs/spousal-sponsorship/`}>sponsoring a spouse, partner, or dependent child</a> and the evidence to consider before applying.</p>
          </div>

          <div class="programs-start-card">
            <span class="programs-start-tag">Temporary status</span>
            <h3>Study or work in Canada</h3>
            <p>Review <a href={`${base}services/#work-study`}>study and work permit options</a> and, for eligible graduates, <a href={`${base}programs/pgwp/`}>post-graduation work permit planning</a>. A temporary permit does not give you permanent residence.</p>
          </div>

        </div>

        <p class="programs-start-note">Compare current requirements with the <a href="https://ircc.canada.ca/explore-programs/">IRCC program finder</a>. If you plan to settle in a participating smaller community, check the <a href="https://www.canada.ca/en/immigration-refugees-citizenship/services/immigrate-canada/rural-franco-pilots.html">Rural and Francophone Community Immigration Pilots</a> for local employer and intake requirements.</p>
      </div>
    </section>

    <!-- Section 0: Core Pathways — Express Entry & PNP -->
    <section style="background: #ffffff; padding: 56px 0;">
      <div class="section-container">

        <div style="margin-bottom: 32px;">
          <p class="program-section-kicker" style="color: #1C2456;">Core Pathways</p>
          <h2 id="economic-pathways" style="font-family: 'Playfair Display', Georgia, serif; font-size: clamp(24px, 2.5vw, 32px); font-weight: 600; color: #1A1A2E; line-height: 1.2; margin-bottom: 12px; scroll-margin-top: 84px;">
            Express Entry &amp; Provincial Nominee Programs
          </h2>
          <p style="font-family: Inter, sans-serif; font-size: 16px; font-weight: 300; color: #45465E; line-height: 1.7; max-width: 640px;">
            Express Entry ranks eligible candidates for federal skilled worker programs. Provinces and territories can also nominate people who meet their own requirements.
          </p>
        </div>

        <div class="grid-programs-2col">

          <!-- Express Entry -->
          <article class="program-card" style="background: #ffffff; border-radius: 10px; border: 1px solid #E8E3D9; overflow: hidden; display: flex; flex-direction: column;">
            <div style="padding: 24px 24px 16px;">
              <div class="program-meta-row">
                <span>Federal system</span>
                <span>Permanent residence</span>
              </div>
              <h3 style="font-family: 'Playfair Display', Georgia, serif; font-size: 22px; font-weight: 700; color: #1A1A2E; line-height: 1.25; margin-bottom: 12px;">
                Express Entry
              </h3>
              <p style="font-family: Inter, sans-serif; font-size: 14px; font-weight: 300; color: #45465E; line-height: 1.75; margin-bottom: 16px;">
                Express Entry is Canada's online application system for several federal economic permanent residence programs. It covers the Federal Skilled Worker Program, the Federal Skilled Trades Program, and the Canadian Experience Class, as well as a portion of the Provincial Nominee Program.
              </p>
              <p style="font-family: Inter, sans-serif; font-size: 14px; font-weight: 300; color: #45465E; line-height: 1.75; margin-bottom: 16px;">
                Eligible candidates enter a pool and are ranked by the Comprehensive Ranking System (CRS). IRCC can hold general, program-specific, or category-based draws. Meeting a category's criteria does not replace eligibility for one of the three federal programs.
              </p>
              <p style="font-family: Inter, sans-serif; font-size: 14px; font-weight: 300; color: #45465E; line-height: 1.75; margin-bottom: 24px;">
                <strong>November 3, 2026 update:</strong> IRCC now compares points for qualifying Canadian work experience against points for a qualifying job offer in an eligible high-wage occupation. It uses the higher score, not both. Express Entry no longer requires a Labour Market Impact Assessment (LMIA) for a job offer to qualify, but work permit rules are separate.
              </p>
              <ul style="list-style: none; padding: 0; margin: 0 0 16px; display: flex; flex-direction: column; gap: 10px;">
                {[
                  'Skilled work experience in an eligible NOC occupation',
                  'Language proficiency in English or French (CLB/NCLC varies by program)',
                  'Education and other eligibility requirements where applicable',
                  'Meeting the specific requirements of at least one Express Entry program',
                ].map((item) => (
                  <li style="display: flex; align-items: flex-start; gap: 10px;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1C2456" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0; margin-top: 2px;"><polyline points="20 6 9 17 4 12"/></svg>
                    <span style="font-family: Inter, sans-serif; font-size: 13px; font-weight: 300; color: #3D3D5C; line-height: 1.6;">{item}</span>
                  </li>
                ))}
              </ul>
              <p style="font-family: Inter, sans-serif; font-size: 12px; font-weight: 300; color: #9C9C9C; line-height: 1.65; margin-bottom: 24px;">
                A job offer may count toward program eligibility without earning CRS points. See IRCC's <a href="https://www.canada.ca/en/immigration-refugees-citizenship/services/immigrate-canada/express-entry/documents/job-offer.html" style="color: #1C2456; text-decoration: underline;">job offer and profile instructions</a>, <a href="https://www.canada.ca/en/immigration-refugees-citizenship/services/immigrate-canada/express-entry/changes.html" style="color: #1C2456; text-decoration: underline;">scoring changes</a>, and <a href="https://www.canada.ca/en/immigration-refugees-citizenship/services/immigrate-canada/express-entry/rounds-invitations.html" style="color: #1C2456; text-decoration: underline;">latest invitation rounds</a>.
              </p>
            </div>
            <div style="padding: 0 24px 24px; margin-top: auto;">
              <a href={`${base}contact/`} class="btn-gold" style="display: inline-flex; align-items: center; gap: 8px; font-family: Inter, sans-serif; font-size: 14px; font-weight: 500; color: #1A1A2E; background: #C4973A; padding: 12px 22px; border-radius: 8px; text-decoration: none;">
                Review this program
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
            </div>
          </article>

          <!-- Provincial Nominee Program -->
          <article class="program-card" style="background: #ffffff; border-radius: 10px; border: 1px solid #E8E3D9; overflow: hidden; display: flex; flex-direction: column;">
            <div style="padding: 24px 24px 16px;">
              <div class="program-meta-row">
                <span>Federal-provincial program</span>
                <span>Nomination route</span>
              </div>
              <h3 style="font-family: 'Playfair Display', Georgia, serif; font-size: 22px; font-weight: 700; color: #1A1A2E; line-height: 1.25; margin-bottom: 12px;">
                Provincial Nominee Program (PNP)
              </h3>
              <p style="font-family: Inter, sans-serif; font-size: 14px; font-weight: 300; color: #45465E; line-height: 1.75; margin-bottom: 16px;">
                The Provincial Nominee Program allows Canadian provinces and territories to nominate candidates for permanent residence based on local labour market and economic needs. Each province operates its own streams with distinct eligibility criteria, occupation lists, and intake schedules.
              </p>
              <p style="font-family: Inter, sans-serif; font-size: 14px; font-weight: 300; color: #45465E; line-height: 1.75; margin-bottom: 16px;">
                Accepting an Express Entry nomination adds 600 CRS points. Other streams use a non-Express Entry process. A nomination is not permanent residence; IRCC makes the final decision.
              </p>
              <p style="font-family: Inter, sans-serif; font-size: 14px; font-weight: 300; color: #45465E; line-height: 1.75; margin-bottom: 24px;">
                Compare the streams where you genuinely intend to settle. Quebec and Nunavut do not have a PNP. If you intend to settle in Ontario, check the <a href={`${base}programs/oinp/`} style="color: #1C2456; text-decoration: underline;">Ontario Workforce Priority stream</a>.
              </p>
              <ul style="list-style: none; padding: 0; margin: 0 0 16px; display: flex; flex-direction: column; gap: 10px;">
                {[
                  'Eligibility for the specific provincial or territorial stream',
                  'A qualifying job offer or connection to the province where required',
                  'An expression of interest or invitation where the stream requires one',
                  'Separate Express Entry eligibility if using an aligned stream',
                ].map((item) => (
                  <li style="display: flex; align-items: flex-start; gap: 10px;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1C2456" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0; margin-top: 2px;"><polyline points="20 6 9 17 4 12"/></svg>
                    <span style="font-family: Inter, sans-serif; font-size: 13px; font-weight: 300; color: #3D3D5C; line-height: 1.6;">{item}</span>
                  </li>
                ))}
              </ul>
              <p style="font-family: Inter, sans-serif; font-size: 12px; font-weight: 300; color: #9C9C9C; line-height: 1.65; margin-bottom: 24px;">
                PNP streams open and close frequently. Intake windows, occupation lists, and eligibility thresholds vary by province and can change without notice.
              </p>
            </div>
            <div style="padding: 0 24px 24px; margin-top: auto;">
              <a href={`${base}contact/`} class="btn-gold" style="display: inline-flex; align-items: center; gap: 8px; font-family: Inter, sans-serif; font-size: 14px; font-weight: 500; color: #1A1A2E; background: #C4973A; padding: 12px 22px; border-radius: 8px; text-decoration: none;">
                Review this program
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
            </div>
          </article>

        </div>
      </div>
    </section>

    <!-- Canadian experience and Ontario nomination -->
    <section aria-labelledby="canadian-experience-ontario" style="background: #FAF7F2; padding: 56px 0;">
      <div class="section-container">

        <div style="margin-bottom: 32px;">
          <p class="program-section-kicker" style="color: #92400E;">Canadian experience and employment</p>
          <h2 id="canadian-experience-ontario" style="font-family: 'Playfair Display', Georgia, serif; font-size: clamp(24px, 2.5vw, 32px); font-weight: 600; color: #1A1A2E; line-height: 1.2; margin-bottom: 12px;">
            Canadian Experience Class and Ontario Nomination
          </h2>
          <p style="font-family: Inter, sans-serif; font-size: 16px; font-weight: 300; color: #45465E; line-height: 1.7; max-width: 640px;">
            The Canadian Experience Class looks at qualifying work you have already done in Canada. Ontario's stream has separate rules for people with a job offer and for self-employed physicians.
          </p>
        </div>

        <div class="grid-programs-2col">

          <!-- Canadian Experience Class and in-Canada applicants -->
          <article class="program-card" style="background: #ffffff; border-radius: 10px; border: 1px solid #E8E3D9; overflow: hidden; display: flex; flex-direction: column;">
            <div class="program-card-body program-card-body-balanced" style="padding: 24px 24px 16px;">
              <div class="program-meta-row">
                <span>Express Entry program</span>
                <span>Canadian work experience</span>
              </div>
              <h3 style="font-family: 'Playfair Display', Georgia, serif; font-size: 22px; font-weight: 700; color: #1A1A2E; line-height: 1.25; margin-bottom: 12px;">
                Canadian Experience Class
              </h3>
              <p style="font-family: Inter, sans-serif; font-size: 14px; font-weight: 300; color: #45465E; line-height: 1.75; margin-bottom: 24px;">
                The Canadian Experience Class (CEC) is for people with skilled Canadian work experience. No job offer or educational credential is required, but you still need an Express Entry invitation.
              </p>
              <ul style="list-style: none; padding: 0; margin: 0 0 28px; display: flex; flex-direction: column; gap: 10px;">
                {[
                  'One year (1,560 hours) of qualifying paid work in the past three years',
                  'Work in a TEER 0-3 occupation while authorized to work in Canada',
                  'An approved English or French test at the required level',
                  'Full-time student work is excluded, as is self-employment except for some physicians',
                ].map((item) => (
                  <li style="display: flex; align-items: flex-start; gap: 10px;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C4973A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0; margin-top: 2px;"><polyline points="20 6 9 17 4 12"/></svg>
                    <span style="font-family: Inter, sans-serif; font-size: 13px; font-weight: 300; color: #3D3D5C; line-height: 1.6;">{item}</span>
                  </li>
                ))}
              </ul>
              <div class="program-card-note" style="background: #FFFBEB; border: 1px solid #F0D080; border-radius: 8px; padding: 14px 16px; margin-bottom: 24px;">
                <p style="font-family: Inter, sans-serif; font-size: 13px; font-weight: 400; color: #78350F; line-height: 1.6; margin: 0;">
                  <strong>Not a new TR to PR intake:</strong> The <a href="https://www.canada.ca/en/immigration-refugees-citizenship/services/application/application-forms-guides/guide-5069-temporary-resident-permanent-resident-pathway.html" style="color: inherit; text-decoration: underline;">2021 pathway</a> remains closed. The <a href="https://www.canada.ca/en/immigration-refugees-citizenship/corporate/immigration-system/measures.html" style="color: inherit; text-decoration: underline;">In-Canada Workers Initiative</a> speeds up selected permanent residence files already submitted; it does not accept separate applications.
                </p>
              </div>
            </div>
            <div style="padding: 0 24px 24px; margin-top: auto;">
              <a href={`${base}contact/`} class="btn-gold" style="display: inline-flex; align-items: center; gap: 8px; font-family: Inter, sans-serif; font-size: 14px; font-weight: 500; color: #1A1A2E; background: #C4973A; padding: 12px 22px; border-radius: 8px; text-decoration: none;">
                Review this program
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
            </div>
          </article>

          <!-- Ontario Workforce Priority and OINP redesign -->
          <article class="program-card" style="background: #ffffff; border-radius: 10px; border: 1px solid #E8E3D9; overflow: hidden; display: flex; flex-direction: column;">
            <div class="program-card-body program-card-body-balanced" style="padding: 24px 24px 16px;">
              <div class="program-meta-row">
                <span>Ontario update</span>
                <span>OINP redesign</span>
              </div>
              <h3 style="font-family: 'Playfair Display', Georgia, serif; font-size: 22px; font-weight: 700; color: #1A1A2E; line-height: 1.25; margin-bottom: 12px;">
                Ontario Workforce Priority Stream
              </h3>
              <p style="font-family: Inter, sans-serif; font-size: 14px; font-weight: 300; color: #45465E; line-height: 1.75; margin-bottom: 24px;">
                The Ontario Workforce Priority stream replaced eight former Ontario Immigrant Nominee Program streams in 2026. It serves eligible workers with Ontario job offers and certain self-employed physicians.
              </p>
              <ul style="list-style: none; padding: 0; margin: 0 0 28px; display: flex; flex-direction: column; gap: 10px;">
                {[
                  'TEER 0-3 job offer category',
                  'TEER 4-5 job offer category',
                  'Self-employed physician category',
                  'For job-offer categories, the employer starts the process before the worker registers an expression of interest',
                ].map((item) => (
                  <li style="display: flex; align-items: flex-start; gap: 10px;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C4973A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0; margin-top: 2px;"><polyline points="20 6 9 17 4 12"/></svg>
                    <span style="font-family: Inter, sans-serif; font-size: 13px; font-weight: 300; color: #3D3D5C; line-height: 1.6;">{item}</span>
                  </li>
                ))}
              </ul>
              <div class="program-card-note" style="background: #ECFDF5; border: 1px solid #6EE7B7; border-radius: 8px; padding: 14px 16px; margin-bottom: 24px;">
                <p style="font-family: Inter, sans-serif; font-size: 13px; font-weight: 400; color: #065F46; line-height: 1.6; margin: 0;">
                  <strong>Before registering:</strong> Ontario updated its earnings-history scoring in October 2026. Check the <a href="https://www.ontario.ca/page/ontario-workforce-priority-stream" style="color: inherit; text-decoration: underline;">stream criteria and scoring factors</a> separately. Meeting the criteria does not guarantee an invitation.
                </p>
              </div>
            </div>
            <div style="padding: 0 24px 24px; margin-top: auto;">
              <a href={`${base}programs/oinp/`} class="btn-gold" style="display: inline-flex; align-items: center; gap: 8px; font-family: Inter, sans-serif; font-size: 14px; font-weight: 500; color: #1A1A2E; background: #C4973A; padding: 12px 22px; border-radius: 8px; text-decoration: none;">
                Read the OINP guide
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
            </div>
          </article>

        </div>
      </div>
    </section>

    <!-- Section 2: Common Client Pathways -->
    <section style="background: #ffffff; padding: 56px 0;">
      <div class="section-container">

        <div style="margin-bottom: 32px;">
          <p class="program-section-kicker" style="color: #1C2456;">Study, Work and Family</p>
          <h2 style="font-family: 'Playfair Display', Georgia, serif; font-size: clamp(24px, 2.5vw, 32px); font-weight: 600; color: #1A1A2E; line-height: 1.2; margin-bottom: 12px;">
            Study Permits, Work Permits and Family Sponsorship
          </h2>
          <p style="font-family: Inter, sans-serif; font-size: 16px; font-weight: 300; color: #45465E; line-height: 1.7; max-width: 680px;">
            Study and work permits provide temporary status. Family sponsorship is a separate route to permanent residence for eligible relatives.
          </p>
        </div>

        <div class="grid-programs-3col">

          <!-- Study Permit and PGWP -->
          <article class="program-card" style="background: #ffffff; border-radius: 10px; border: 1px solid #E8E3D9; padding: 24px; display: flex; flex-direction: column;">
            <div class="program-meta-row program-meta-row-compact">
              <span>Student route</span>
              <span>PGWP</span>
            </div>
            <h3 style="font-family: 'Playfair Display', Georgia, serif; font-size: 19px; font-weight: 700; color: #1A1A2E; line-height: 1.3; margin-bottom: 12px;">
