---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import HeroSection from '../components/HeroSection.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import AboutSection from '../components/AboutSection.astro';
import FaqSection from '../components/FaqSection.astro';
import TestimonialsGrid from '../components/TestimonialsGrid.astro';
import CtaSection from '../components/CtaSection.astro';
import Footer from '../components/Footer.astro';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Entrypoint Canada',
  alternateName: 'Entrypoint Canada Immigration Services',
  url: Astro.site?.href,
};
---

<Layout
  title="Entrypoint Canada | Canadian Immigration Consulting"
  description="Entrypoint Canada is a regulated immigration practice in Cambridge, Ontario, serving Kitchener-Waterloo, the Greater Toronto Area, and clients abroad."
  heroImage="home"
  schema={websiteSchema}
>
  <Navbar />
  <main id="main-content">
    <HeroSection />
    <ServicesGrid />
    <ProcessSteps />
    <AboutSection />
    <TestimonialsGrid />
    <FaqSection />
    <CtaSection />
  </main>
  <Footer homePhotoCredit />
</Layout>
